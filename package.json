{
  "name": "kelpie",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "KELPIE_CWD=${KELPIE_CWD:-$PWD} turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p .",
    "test": "vitest run",
    "kelpie:run": "tsx --conditions=kelpie-src scripts/run.ts",
    "capture:claude": "tsx --conditions=kelpie-src scripts/capture-claude.ts",
    "kelpie:serve": "tsx --conditions=kelpie-src packages/daemon/src/main.ts"
  },
  "devDependencies": {
    "@kelpie/adapters": "workspace:*",
    "@kelpie/daemon": "workspace:*",
    "@kelpie/protocol": "workspace:*",
    "@kelpie/store": "workspace:*",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "turbo": "2.11.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
