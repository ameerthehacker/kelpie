{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {},
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "KELPIE_CWD",
        "KELPIE_PORT",
        "KELPIE_MODEL",
        "KELPIE_HOME"
      ]
    },
    "kelpie-code#build": {
      "dependsOn": [
        "@kelpie/web#build"
      ],
      "outputs": [
        "dist/**"
      ]
    }
  }
}
