{
  "name": "@kelpie/daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "kelpie-src": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --conditions=kelpie-src src/main.ts",
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@kelpie/adapters": "workspace:*",
    "@kelpie/protocol": "workspace:*",
    "@kelpie/store": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@octokit/rest": "^22.0.1",
    "diff": "^9.0.0",
    "hono": "^4.13.13",
    "lru-cache": "^11.5.3",
    "proper-lockfile": "4.1.2",
    "which": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/proper-lockfile": "^4.1.4",
    "@types/which": "^3.0.4"
  }
}
