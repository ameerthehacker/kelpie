{
  "name": "@kelpie/daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "kelpie-src": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --conditions=kelpie-src src/main.ts",
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@kelpie/adapters": "workspace:*",
    "@kelpie/protocol": "workspace:*",
    "hono": "^4.13.13"
  }
}
